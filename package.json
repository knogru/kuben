{
  "name": "kuben",
  "displayName": "kuben",
  "description": "code autocomplete for developers",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onCommand:kuben.helloWorld"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kuben.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "kuben.toggle",
        "title": "Toggle Kuben Autocomplete"
      },
      {
        "command": "kuben.cancel",
        "title": "Cancel Kuben Generation"
      },
      {
        "command": "kuben.showLatency",
        "title": "Show Kuben Latency Stats"
      },
      {
        "command": "kuben.manageTelemetry",
        "title": "Manage Kuben Telemetry & Privacy"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Kuben Autocomplete Configuration",
      "properties": {
        "kuben.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable the Kuben inline autocomplete extension."
        },
        "kuben.endpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama server endpoint URL."
        },
        "kuben.model": {
          "type": "string",
          "default": "qwen2.5-coder:1.5b",
          "description": "Model to use on the Ollama server."
        },
        "kuben.debounceDelay": {
          "type": "number",
          "default": 300,
          "description": "Debounce delay (ms) before sending a completion request."
        },
        "kuben.contextWindow": {
          "type": "number",
          "default": 30,
          "description": "Number of lines of context to send as prefix."
        },
        "kuben.enableGraphRag": {
          "type": "boolean",
          "default": true,
          "description": "Enable Graph RAG (symbol-aware context injection)."
        },
        "kuben.useASTEngine": {
          "type": "boolean",
          "default": true,
          "description": "Enable AST-based symbol indexing (DocumentSymbol MVP). Set false to use naive indexing."
        },
        "kuben.modelPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to a locally-tuned model file for deployment (e.g., fine-tuned GGUF)."
        },
        "kuben.telemetry.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable latency telemetry collection (session-scoped, no data sent externally)."
        },
        "kuben.telemetry.optIn": {
          "type": "boolean",
          "default": false,
          "description": "Opt-in to code snippet collection for fine-tuning dataset (requires explicit user consent)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "tree-sitter-javascript": "^0.25.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "web-tree-sitter": "^0.20.0"
  }
}
